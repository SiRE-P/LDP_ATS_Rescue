@techreport{baileyOsoyoosLakeSockeye2025,
  title = {Osoyoos {{Lake Sockeye Salmon}} ({{Oncorhynchus}} Nerka) Return Abundance (1977-2023), Adult Age Composition (1985-2023), and Marine Survival (1998-2021)},
  author = {Bailey, Colin J. and Stiff, Howard W. and Thompson, Patrick L. and Judson, Braden and Ogden, Athena D.},
  year = 2025,
  month = jan,
  journal = {Canadian manuscript report of fisheries and aquatic sciences},
  institution = {{Fisheries and Oceans Canada}},
  issn = {1488-5387},
  doi = {10.60825/V3G8-JW96},
  urldate = {2026-08-26},
  abstract = {Ce rapport pr\'esente l'abondance historique des retours de saumons rouges adultes d'Osoyoos \`a l'embouchure du fleuve Columbia de 1977 \`a 2023, la composition par \^age depuis 1985 et les taux de survie des saumoneaux aux adultes pour les ann\'ees d'entr\'ee dans l'oc\'ean de 1998 \`a 2021, d'apr\`es les donn\'ees disponibles sur l'abondance des juv\'eniles. Les ensembles de donn\'ees ont \'et\'e obtenus \`a partir de diverses sources, y compris des estimations de l'abondance annuelle des saumons rouges adultes par l'interm\'ediaire du portail de donn\'ees CBR-DART (Columbia Basin Research Data Access in Real Time), des donn\'ees sur les prises du Washington Department of Fisheries and Wildlife (WDFW), la composition par \^age des stocks de la Columbia River Intertribal Fish Commission (CRITFC), des donn\'ees de relev\'es sur les fray\`eres de l'Okanagan Nation Alliance (ONA) et des estimations de l'abondance des pr\'esaumoneaux provenant des relev\'es acoustiques et des relev\'es au chalut en Lac Osoyoos (ONA et MPO).},
  collaborator = {{Fisheries And Oceans Canada}},
  langid = {english}
}

@incollection{centerforsystemsintegration2019a,
  title = {From {{Catastrophe}} to {{Recovery}}: {{Stories}} of {{Fishery Management Success}}},
  shorttitle = {From {{Catastrophe}} to {{Recovery}}},
  booktitle = {From {{Catastrophe}} to {{Recovery}}: {{Stories}} of {{Fishery Management Success}}},
  editor = {{Center for Systems Integration and Sustainability Department of Fisheries and Wildlife Michigan State University East Lansing, Michigan 48823, USA} and Krueger, Charles C. and Taylor, William W. and {Center for Systems Integration and Sustainability Department of Fisheries and Wildlife Michigan State University East Lansing, Michigan 48823, USA} and Youn, So-Jung and {Center for Systems Integration and Sustainability Department of Fisheries and Wildlife Michigan State University East Lansing, Michigan 48823, USA}},
  year = 2019,
  publisher = {American Fisheries Society},
  doi = {10.47886/9781934874554.ch4},
  urldate = {2026-08-26},
  abstract = {\emph{Abstract.}\~A¢\^a\quotesinglbase\textlnot\^a\texteuro Since the mid-1800s, human activities have increasingly dominated ecosystems within the Okanagan River basin, which spans the Canada\~A¢\^a\quotesinglbase\textlnot\^a\texteuro\oe United States border between British Columbia and Washington State. Over the past 50 years, fisheries for anadromous salmon in the Okanagan River basin virtually disappeared as once abundant stocks, such as Sockeye Salmon \emph{Oncorhynchus nerka}, declined to fewer than 10,000 adults returning annually (on average) in the 1990s. Threat assessments suggested degradation of freshwater habitat in the Columbia River basin as the general cause for the decline. However, recent record returns (2008\~A¢\^a\quotesinglbase\textlnot\^a\texteuro\oe 2016 average {$>$}200,000 adults) indicated surprising resilience and recovery. Review of recent stock management and restoration efforts focused on Okanagan Sockeye Salmon indicated that management actions and fortuitous events facilitated the restoration of salmon to levels exceeding recorded, historic maxima. Actions and events identified include (1) assessment to determine whether large increases in escapement provided evidence of historic underuse of spawning (Okanagan River) and rearing environment (Osoyoos Lake) capacities; (2) development of a decision support system to facilitate fish-friendly water management, which reduced losses of eggs or fry to density-independent events (Okanagan River and Lake); (3) a small contribution ({$<$}10\% of total production) of hatchery-origin fish; and (4) a coincidental return to favorable marine conditions for Okanagan Sockeye Salmon. Recovery success also involved development of an ecosystem-based sustainability strategy incorporating a shared vision for dealing with human and natural system impacts on salmon from local (Okanagan River basin) to global (North Pacific Ocean) scales. Key elements that characterized efforts to restore Okanagan Sockeye Salmon were the development of ecosystem-based management (including elevated levels of engagement, cooperation, and collaboration among responsible parties to support a common cause); the creation of new knowledge of complex cause-and-effect ecological, economic, and cultural associations; and the creation of new resource management tools (e.g., models and decision support systems). Science-based collaboration to restore aquatic ecosystems and Okanagan salmon is an example of positive outcomes resulting from implementation of Canada\~A¢\^a\quotesinglbase\textlnot\^a,,¢s 2005 Wild Salmon Policy.},
  isbn = {978-1-934874-55-4}
}

